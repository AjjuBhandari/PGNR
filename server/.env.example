PORT=4000
JWT_SECRET=2750c3a976c7088abb1bfbd945f668016c8fd17da3e3a43b6c78a34382456049
ADMIN_USERNAME=admin
# bcrypt hash of your admin password generated for the requested login
ADMIN_PASSWORD_HASH=$2a$10$kxjablKFu5CauYUT2GoRB.8ola/QlVbvh13l6eYc.0EHXTwcPigR2
BOT_ENCRYPTION_KEY=b10af24f30f6da3cf625361047c7c3f96caa9c2f1b6dce1943cd19ec9baddefe
DEFAULT_MC_HOST=localhost
DEFAULT_MC_VERSION=1.20.4

# AI providers (optional, stored server-side only)
# AI_PROVIDER selects which client to build: openai | deepseek | keyless
AI_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
AI_DECISION_INTERVAL_MS=3000

# Real-server auto-login flow (used by the non-mock mineflayer driver).
# Matches servers that gate join behind /register + /login and route you
# through a hub to a target sub-server, e.g. via "/server <name>".
MC_AUTH_MODE=offline
MC_LOGIN_TIMEOUT_MS=30000
MC_TARGET_SERVER=
MC_TARGET_SERVER_RETRY_MS=8000
MC_TARGET_SERVER_MAX_RETRIES=5

# Discord webhook for death/kick notifications (optional)
DISCORD_WEBHOOK_URL=

# Set to "true" to run with simulated bots instead of connecting to a real
# Minecraft server. Useful for developing the dashboard UI safely.
MOCK_MODE=true
